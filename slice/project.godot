; Mega Tycoon – Grey-Box-Slice (F-14, Sprint 4). Basis Prototyp v3, Karte S-10, Ökonomie F-16/T-06.
config_version=5

[application]

config/name="Mega Tycoon Slice"
run/main_scene="res://start_menu.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[mega_tycoon]

; W-01 (S7): Welt beim Start, "slice" (Default) oder "s7". Lokal umstellen, committet bleibt "slice".
; Kommandozeile --welt=... hat Vorrang. Siehe world/welt.gd.
welt="slice"

[physics]

common/physics_ticks_per_second=10
common/physics_interpolation=true
